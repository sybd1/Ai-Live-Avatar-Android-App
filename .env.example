# Copy to .env. Server secrets must never use EXPO_PUBLIC_ names.
SERVER_PORT=8080
DATABASE_PORT=55432
DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/firststep
DATABASE_USERNAME=firststep
DATABASE_PASSWORD=
DEMO_MODE=false
AI_DATA_MODE=synthetic
TEXT_PROVIDER=gemini
TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
TTS_PROVIDER=gemini
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
AI_MONTHLY_BUDGET=0
TTS_MONTHLY_CHAR_LIMIT=10000
STT_PROVIDER=faster-whisper
STT_AUTOSTART=false
STT_WORKER_URL=http://127.0.0.1:8091
STT_WORKER_TOKEN=
STT_MODEL_PATH=
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
YOUTH_POLICY_API_KEY=
POLICY_PROVIDER_BASE_URL=
POLICY_SYNC_ENABLED=false
KAKAO_REST_API_KEY=
MAP_ROUTING_ENABLED=false
EXPO_PUBLIC_API_BASE_URL=


AI_ENABLED=false
AI_DAILY_REQUEST_LIMIT=100

# Combined Live input/output, reserved in 10-second units
LIVE_DAILY_AUDIO_SECONDS=600
