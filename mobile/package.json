  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@interviewflowai/talking-avatar": "^0.1.3",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "three": "^0.186.1",
    "expo-audio": "~58.0.10",
    "expo-file-system": "~58.0.11",
    "expo-location": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "react-native-webview": "14.0.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "prepare:assets": "node scripts/prepare-avatar-assets.mjs",
    "avatar:build": "node scripts/prepare-avatar-assets.mjs && node scripts/build-avatar.mjs",
    "export:android": "expo export --platform android",
    "test": "node --test tests/*.test.mjs"
